FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates clamav clamav-daemon \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .

RUN mkdir -p /run/clamav /var/log/clamav /var/lib/clamav \
  && sed -i 's/^LocalSocket /#LocalSocket /; s/^User .*/User node/' /etc/clamav/clamd.conf \
  && printf '\nTCPSocket 3310\nTCPAddr 127.0.0.1\n' >> /etc/clamav/clamd.conf \
  && chmod +x /app/scripts/worker-entrypoint.sh \
  && chown -R node:node /app /var/lib/clamav /var/log/clamav /run/clamav

USER node
EXPOSE 3001
ENTRYPOINT ["/app/scripts/worker-entrypoint.sh"]
